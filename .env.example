# Copy to .env. Never commit .env. Every variable used by any app is listed here.

# --- General ---------------------------------------------------------------------------------
NODE_ENV=development

# --- Postgres (docker-compose and Prisma) ----------------------------------------------------
POSTGRES_USER=leads
POSTGRES_PASSWORD=leads
POSTGRES_DB=leads
POSTGRES_PORT=5432
# Used by Prisma in packages/db, apps/api and apps/workers.
DATABASE_URL=postgresql://leads:leads@localhost:5432/leads?schema=public

# --- Redis (BullMQ queues, pub/sub, Socket.IO adapter) -----------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ---------------------------------------------------------------------------------------
API_PORT=3000
# Origin allowed by CORS (the Angular dev server).
CORS_ORIGIN=http://localhost:4200

# --- Auth (JWT, phase 3) ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password for the seeded demo users (admin@demo.local, sales@demo.local).
DEMO_USER_PASSWORD=demo1234

# --- Realtime gateway (phase 3) ----------------------------------------------------------------
# Window used to batch lead events before sending them to clients.
GATEWAY_BATCH_WINDOW_MS=200
# Socket outbound buffer size (engine writeBuffer packets) above which batches are merged, not queued.
GATEWAY_BACKPRESSURE_THRESHOLD=64
# Max seq gap replayed from Postgres on reconnect; larger gaps get a full resync instruction.
GATEWAY_REPLAY_MAX_GAP=5000

# --- Scrapers (phase 2+) -----------------------------------------------------------------------
# GitHub REST API token (no scopes needed for public data). Hourly rate limit applies.
GITHUB_TOKEN=
# SEC EDGAR requires a descriptive User-Agent with contact info, e.g. "Acme Research you@example.com".
SEC_EDGAR_USER_AGENT=
# User-Agent for all other scrapers and website enrichment.
SCRAPER_USER_AGENT=
# Page fetcher of the website enrichment source: "http" (default) or "playwright" (needs the optional
# playwright-core package and `npx playwright install chromium`, installed by you).
WEBSITE_FETCHER=http
# Path to the editable list of Greenhouse/Lever company slugs.
SCRAPER_COMPANIES_CONFIG=apps/workers/config/companies.json

# --- Observability -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Port of the workers' Prometheus endpoint (GET /metrics). 0 disables it.
WORKERS_METRICS_PORT=3100
