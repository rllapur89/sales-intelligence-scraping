{
  "name": "@leads/desktop",
  "version": "0.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "build:electron": "ng build --configuration=electron && node scripts/fix-electron-base.js",
    "electron:dev": "npm run build:electron && electron .",
    "electron:dist": "npm run build:electron && electron-builder",
    "start:live": "ng serve --configuration=development,live",
    "build:live": "ng build --configuration=production,live"
  },
  "build": {
    "appId": "com.salesintel.app",
    "productName": "Leads Sales Intelligence",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.6",
    "@leads/shared": "*",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/entity": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "vitest": "^4.0.8"
  }
}
