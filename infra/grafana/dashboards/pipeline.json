{
  "uid": "leads-pipeline",
  "title": "Sales Intelligence pipeline",
  "tags": [
    "leads"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
